# 推荐先运行 uv run python configure.py，自动生成本机 .env。
# 本文件是示例，下面的密钥占位符不能直接用于启动。
JOIN_CODE=replace-with-your-invitation-code
# 可选管理员加入码；设置后必须与 JOIN_CODE 不同。
ADMIN_JOIN_CODE=
CREDENTIAL_KEY=replace-with-generated-fernet-key
PUBLIC_ORIGIN=http://localhost:8000
# 可选：本地使用 DATABASE_PATH；Vercel 部署时配置 Neon 提供的 PostgreSQL 连接串。
DATABASE_URL=
DATABASE_PATH=data/course-helper.sqlite3
BATCH_CONCURRENCY=10
